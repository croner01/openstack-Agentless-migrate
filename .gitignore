uploads/

# 日志（LOG_FILE 默认落在 uploads/ 下，根目录的历史日志一并忽略）
*.log

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
*.swp

# 本地构建产物（镜像 tar 包等）
*.tar
*.tar.gz
